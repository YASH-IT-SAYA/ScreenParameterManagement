<Window x:Class="SimpleLoginSystem.AddSelectMasterParameterPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        WindowStartupLocation="CenterScreen"
        xmlns:local="clr-namespace:SimpleLoginSystem"
        mc:Ignorable="d"
        
        Title="AddSelectMasterParameterPage" Height="450" Width="800" Loaded="Window_Loaded">
    <Window.Background>
        <ImageBrush ImageSource="/Images/LoginWindowBackgroundImage.jpg" Stretch="Fill"/>
    </Window.Background>
    <Grid>
        <Border BorderBrush="White" BorderThickness="1.8" Width="auto" Padding="20" CornerRadius="20" HorizontalAlignment="Center" VerticalAlignment="Center">
         
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left">
                <Label Content="AddSelectMasterParameterPage" FontWeight="SemiBold" HorizontalAlignment="Center" FontSize="18" Margin="0 0 0 15" Foreground="White"/>
                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                    <Label Content="Screen Master :" FontSize="15" Foreground="White"/>
                    <ComboBox Name="ScreenMasterComboBox" Margin="6 0 0 0" FontSize="15" Width="180" Height="27"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Margin="0 10 0 0" HorizontalAlignment="Left">
                    <Label Content="ParameterName" FontSize="15" HorizontalContentAlignment="Left" Foreground="White"/>
                    <TextBox x:Name="ParameterNameTextBox" Width="180" Height="22" FontSize="15"/>
                </StackPanel>
                <!--<StackPanel VerticalAlignment="Center" Orientation="Horizontal" Margin="0 10 0 0">
                    <Label Content="Is Deleted?" Margin="0 0 20 0" FontSize="15" Foreground="White"/>
                    <RadioButton x:Name="IsDeletedYes" Content="Yes" Margin="0 2 10 0" GroupName="IsDeleted" FontSize="15" VerticalAlignment="Center" Foreground="White"/>
                    <RadioButton x:Name="IsDeletedNo" Content="No" Margin="0 2 0 0" GroupName="IsDeleted" FontSize="15" VerticalAlignment="Center" Foreground="White"/>
                </StackPanel>-->
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Margin="0 10 0 0" >
                    <Label Content="Is Active?" Margin="0 0 31 0" FontSize="15" Foreground="White"/>
                    <RadioButton x:Name="IsActiveYes" Content="Yes" Margin="0 0 10 0" VerticalAlignment="Center" GroupName="IsActive" FontSize="15" Foreground="White"/>
                    <RadioButton x:Name="IsActiveNo" Content="No"  GroupName="IsActive" FontSize="15" VerticalAlignment="Center" Foreground="White"/>
                </StackPanel>
                <Button x:Name="Save" Margin="0 25 0 0" Content="Save" Width="80" Height="30" FontSize="15" Click="Save_parameter_Click" FontWeight="SemiBold" Background="Green" Foreground="White" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
