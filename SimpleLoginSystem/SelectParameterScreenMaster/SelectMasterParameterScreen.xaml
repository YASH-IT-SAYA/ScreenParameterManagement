<Window x:Class="SimpleLoginSystem.SelectMasterParameterScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SimpleLoginSystem"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        WindowState="Maximized"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="SelectMasterParameterScreen" Height="450" Width="800"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/SimpleLoginSystem;component/Images/LoginWindowBackgroundImage.jpg"/>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" BorderBrush="White" BorderThickness="0 0 0 2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Image Source="/Images/nkplogoNotagline.png" Margin="11" Width="65"  >
                            <Image.OpacityMask>
                                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                    <GradientStop Color="Black" Offset="0"/>
                                    <GradientStop Color="#FFAC3F3F" Offset="1"/>
                                </LinearGradientBrush>
                            </Image.OpacityMask>
                        </Image>
                    </Grid>
                    <Grid Grid.Column="1">
                        <Label Foreground="White" Content="Master Page Parameters" VerticalAlignment="Center" FontSize="20" HorizontalAlignment="Center" FontWeight="Bold"/>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Border Grid.Column="0" BorderBrush="White" BorderThickness="0, 0, 0, 0" Padding="10">
                    <StackPanel Orientation="Vertical">
                        <Button x:Name="Add_parameter" Padding="6" Margin="6" Width="auto" FontSize="16" Click="Add_parameter_Click" Background="ForestGreen" Foreground="White">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Add" FontWeight="SemiBold"/>
                                <fa:ImageAwesome Icon="Plus" Width="15" Height="15" Foreground="White" Margin="31,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="Update_parameter" Padding="6" Margin="6" Width="auto" FontSize="16" Click="Update_parameter_Click" Background="Orange" Foreground="White">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Update" FontWeight="SemiBold"/>
                                <fa:ImageAwesome Icon="Edit" Width="15" Height="15"  Foreground="White" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="SoftDeleteparameter" Padding="6" Margin="6" Width="auto" FontSize="16" Click="SoftDeleteparameter_Click" Background="Red" Foreground="White">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Delete" FontWeight="SemiBold"/>
                                <fa:ImageAwesome Icon="Trash" Width="15" Height="15"  Foreground="White" Margin="14,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <ComboBox Name="ComboBox1" FontSize="14" Width="250" Grid.Row="0" Height="25" Margin="10" SelectionChanged="ComboBox1_SelectionChanged" HorizontalAlignment="Right"
                          />
                <DataGrid BorderBrush="White" Margin="10,10,10,20" BorderThickness="0 0 0 0" Background="Transparent" Grid.Row="1" 
                          x:Name="ParameterDataGrid" AutoGenerateColumns="False" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding ParameterID}" Width="auto" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Parameter Name" Binding="{Binding ParameterName}" Width="*" IsReadOnly="True"/>
                        <DataGridCheckBoxColumn Header="Is Active"  Binding="{Binding IsActive}" Width="100" IsReadOnly="True"/>
                        <DataGridCheckBoxColumn Header="Is Deleted" Binding="{Binding IsDeleted}" Width="100 " IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
      
    </Grid>
</Window>

    