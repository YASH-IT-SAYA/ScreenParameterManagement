<Window x:Class="SimpleLoginSystem.UpdateFormParameterMasterPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SimpleLoginSystem"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="UpdateFormParameterMasterPage" Height="450" Width="800">
    <Window.Background>
        <ImageBrush ImageSource="/Images/LoginWindowBackgroundImage.jpg" Stretch="Fill"/>
    </Window.Background>
    <Grid>
        <Border Width="auto" Padding="20" CornerRadius="20" BorderThickness="2" BorderBrush="White" HorizontalAlignment="Center" VerticalAlignment="Center">
          
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left">
                <Label Content="Update Select Parameter Master Page" FontWeight="SemiBold" HorizontalAlignment="Center" FontSize="18" Margin="0 0 0 15" Foreground="White"/>
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal" HorizontalAlignment="Left">
                    <Label Content="Parameter Name" Margin="0 0 15 0" FontSize="15" HorizontalContentAlignment="Left" Foreground="White"/>
                    <TextBox x:Name="NameTextBox" Width="150" Height="20" FontSize="15"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Margin="0 10 0 0">
                    <Label Content="Is Deleted?" Margin="0 0 44 0" FontSize="15" Foreground="White"/>
                    <RadioButton x:Name="IsDeletedYes" Content="Yes" Margin="0 2 10 0" GroupName="IsDeleted" FontSize="14" VerticalAlignment="Center" Foreground="White"/>
                    <RadioButton x:Name="IsDeletedNo" Content="No" Margin="0 2 0 0" GroupName="IsDeleted" FontSize="14" VerticalAlignment="Center" Foreground="White"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Margin="0 10 0 0" >
                    <Label Content="Is Active?" Margin="0 0 55 0" FontSize="15" Foreground="White"/>
                    <RadioButton x:Name="IsActiveYes" Content="Yes" Margin="0 2 10 0" GroupName="IsActive" FontSize="14" VerticalAlignment="Center" Foreground="White"/>
                    <RadioButton x:Name="IsActiveNo" Content="No" Margin="0 2 0 0" GroupName="IsActive" FontSize="14" VerticalAlignment="Center" Foreground="White"/>
                </StackPanel>
                <Button x:Name="UpdateButton" Margin="0 25 0 0" Content="Update" Width="80" FontWeight="SemiBold" Foreground="White" Height="30" FontSize="15" Click="UpdateButton_Click" Background="Green"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
