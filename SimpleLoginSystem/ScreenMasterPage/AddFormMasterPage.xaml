<Window x:Class="SimpleLoginSystem.AddFormMasterPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SimpleLoginSystem"
        mc:Ignorable="d" WindowStartupLocation="CenterScreen"
        Title="AddFormMasterPage" Height="450" Width="800">
    <Window.Background>
        <ImageBrush ImageSource="/Images/LoginWindowBackgroundImage.jpg" Stretch="Fill"/>
    </Window.Background>
    <Grid>
        <Border Background="Transparent" BorderThickness="2" BorderBrush="White"  Width="auto" Padding="20" CornerRadius="20" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left">
                <Label Content="MasterPageAddForm" FontWeight="SemiBold" HorizontalAlignment="Center" FontSize="18" Margin="0 0 0 15" Foreground="White"/>
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Label Content="Name" Margin="0 0 32 0" FontSize="15" HorizontalContentAlignment="Left" Foreground="White"/>
                    <TextBox x:Name="NameTextBox" Width="130" Height="20" FontSize="15"/>
                </StackPanel>
                <!--<StackPanel VerticalAlignment="Center" Orientation="Horizontal" Margin="0 10 0 0">
                    <Label Content="Is Deleted?" Margin="0 0 5 0" FontSize="15" Foreground="White"/>
                    <RadioButton x:Name="IsDeletedYes" Content="Yes" Margin="0 0 10 0" GroupName="IsDeleted" FontSize="14" VerticalAlignment="Center" Foreground="White"/>
                    <RadioButton x:Name="IsDeletedNo" Content="No" GroupName="IsDeleted" FontSize="14" VerticalAlignment="Center" Foreground="White"/>
                </StackPanel>-->
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Margin="0 10 0 0" >
                    <Label Content="Is Active" Margin="0 0 16 0" FontSize="15" Foreground="White"/>
                    <RadioButton x:Name="IsActiveYes" Content="Yes" Margin="0 0 10 0" GroupName="IsActive" FontSize="14" VerticalAlignment="Center" Foreground="White"/>
                    <RadioButton x:Name="IsActiveNo" Content="No"  GroupName="IsActive" FontSize="14" VerticalAlignment="Center" Foreground="White"/>
                </StackPanel>
                <Button x:Name="Save" Margin="0 25 0 0" Content="Save" Width="80" Background="Green" Foreground="White" FontWeight="SemiBold" Height="30" FontSize="15" Click="Save_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>


