<Window x:Class="SimpleLoginSystem.AfterLoginPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SimpleLoginSystem"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        mc:Ignorable="d"
         WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Title="SelectMasterPage" Height="450" Width="800" Loaded="Window_Loaded">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/SimpleLoginSystem;component/Images/LoginWindowBackgroundImage.jpg"/>
        </Grid.Background>
        <!--<Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*"/>
            <ColumnDefinition Width="300*"/>
            <ColumnDefinition Width="539*"/>
        </Grid.ColumnDefinitions>-->
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" BorderBrush="White" BorderThickness="0 0 0 2" Grid.ColumnSpan="3">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Image Source="/Images/nkplogoNotagline.png" Margin="8" Width="60"  />
                    </Grid>
                    <Grid Grid.Column="1" >
                        <Label Grid.Column="1" Content="Master Page" Foreground="White" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Grid.ColumnSpan="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="White" BorderThickness="0 0 0 0" Padding="10">
                <StackPanel Orientation="Vertical">
                    <Button x:Name="Add" Padding="6" Margin="6" Width="auto" FontSize="16" Click="Add_Click" Background="ForestGreen" Foreground="White">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Add" FontWeight="SemiBold"/>
                            <fa:ImageAwesome Icon="Plus" Width="15" Height="15" Foreground="White" Margin="28,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="Update" Padding="6" Margin="6" Width="auto" FontSize="16" Click="Update_Click" Background="Orange" Foreground="White">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Update" FontWeight="SemiBold"/>
                            <fa:ImageAwesome Icon="Edit" Width="15" Height="15"  Foreground="White" Margin="9,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SoftDelete" Padding="6" Margin="6" Width="auto" FontSize="16" Click="SoftDelete_Click" Background="Red" Foreground="White">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Delete" FontWeight="SemiBold"/>
                            <fa:ImageAwesome Icon="Trash" Width="15" Height="15"  Foreground="White" Margin="13,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
            <DataGrid Margin="10,10,10,20" BorderThickness="0 0 0 0" BorderBrush="White" x:Name="DataGridMaster" Background="Transparent" Grid.Column="1" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" AutoGenerateColumns="False" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="auto" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="IsActive" Binding="{Binding IsActive}" Width="150" IsReadOnly="True"/>
                    <DataGridTextColumn Header="IsDeleted" Binding="{Binding IsDeleted}" Width="150" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
       
    </Grid>
</Window>
