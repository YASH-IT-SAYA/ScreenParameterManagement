<Window x:Class="SimpleLoginSystem.SwitchingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SimpleLoginSystem"
        xmlns:fa="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF"
        mc:Ignorable="d" WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Title="SwitchingWindow" Height="450" Width="800">

    <Window.Background>
        <ImageBrush ImageSource="/Images/LoginWindowBackgroundImage.jpg" Stretch="Fill"/>
    </Window.Background>
    <Grid>
        <Border Width="280" Padding="20" CornerRadius="15"
                HorizontalAlignment="Center" VerticalAlignment="Center" 
                BorderBrush="White" BorderThickness="2">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" >
                <TextBlock Text="Choose The Window" FontSize="20" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="10" Foreground="White"/>
                <Button x:Name="SelectMasterPage" Margin="10" Padding="10" Background="Transparent" BorderThickness="0" BorderBrush="White" Click="SelectMasterPage_Click" Foreground="White">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <fa:ImageAwesome Icon="ListAlt" Width="18" Height="18" Margin="0,0,10,0" Foreground="White"/>
                        <TextBlock Text="Select Master Page" FontWeight="Bold" FontSize="15"/>
                    </StackPanel>
                </Button>
                <Button x:Name="SelectParameterMasterPage" Margin="10" Padding="10" Background="Transparent" BorderThickness="0" BorderBrush="White" Click="SelectParameterMasterPage_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <fa:ImageAwesome Icon="Slideshare" Width="18" Height="18" Foreground="White" Margin="0,0,10,0"/>
                        <TextBlock Text="Parameter Master Page" FontSize="15" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Button>
                <Button x:Name="LogoutButton" Margin="10" Padding="10" Background="Transparent" BorderThickness="0" BorderBrush="White" Click="LogoutButton_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <fa:ImageAwesome Icon="SignOut" Width="18" Height="18" Margin="0,0,10,0" Foreground="White"/>
                        <TextBlock Text="Logout" FontWeight="Bold" FontSize="15" Foreground="White"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
